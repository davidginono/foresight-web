# Same-project Vercel Function. An empty value explicitly disables online enquiries.
VITE_FORM_ENDPOINT=/api/enquiries

# Server-only email configuration. Never prefix these with VITE_.
# Use your mail provider's authenticated SMTP host and approved sender mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Defaults to the shared company email if omitted.
INQUIRY_TO=info@foresight.co.tz

# Optional authorized event collector accepting JSON POSTs. No personal form data.
# Leave blank until the analytics provider, retention and access are agreed.
VITE_ANALYTICS_ENDPOINT=
